{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "public": "public",
    "rewrites": [
      {
        "source": "/adminpanel",
        "destination": "/index.html"
      },
      {
        "source": "/adminpanel/**",
        "destination": "/index.html"
      },
      {
        "source": "/teachers",
        "destination": "/index.html"
      },
      {
        "source": "/teachers/**",
        "destination": "/index.html"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ]
  }
}
